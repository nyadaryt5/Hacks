# ==============================================================
# ULTRON v6 — environment configuration reference
# Copy to .env (or export these variables) before running.
# ==============================================================

# --- Google AI (required) -------------------------------------
# Primary Gemini API key. At least one of GOOGLE_API_KEY or
# GOOGLE_API_KEY_1..GOOGLE_API_KEY_10 is required.
GOOGLE_API_KEY=<set-me>

# Optional: additional keys, rotated across requests.
# GOOGLE_API_KEY_1=<set-me>
# GOOGLE_API_KEY_2=<set-me>

# --- Google AI tuning (ULTRON_ prefixed) ----------------------
ULTRON_MODEL=gemini-1.5-flash
# ULTRON_TEMPERATURE=0.3
# ULTRON_MAX_TOKENS=3000
# ULTRON_TIMEOUT_SECONDS=120

# --- Run control ----------------------------------------------
ULTRON_MAX_ITERATIONS=30
ULTRON_MAX_LATERAL_DEPTH=2
ULTRON_OUTPUT_MAX_CHARS=4000
ULTRON_CACHE_TTL_HOURS=24
ULTRON_LOG_LEVEL=INFO

# --- Budget guardrails (ULTRON_BUDGET_ prefixed) ---------------
ULTRON_BUDGET_MAX_TOKENS_PER_SESSION=500000
ULTRON_BUDGET_MAX_TOKENS_PER_MINUTE=10000
ULTRON_BUDGET_MAX_TOKENS_PER_HOUR=100000
ULTRON_BUDGET_MAX_COST_PER_SESSION_USD=1.0
ULTRON_BUDGET_WARN_AT_PERCENT=80.0

# --- Secret managers (production) ------------------------------
# ULTRON_SECRETS_BACKEND=aws
# ULTRON_AWS_SECRET_ID=ultron/google-api-key
# ULTRON_AWS_REGION=us-east-1
# ULTRON_SECRETS_BACKEND=vault
# ULTRON_VAULT_ADDR=https://vault.example:8200
# ULTRON_VAULT_TOKEN=<set-me>
# ULTRON_VAULT_SECRET_PATH=ultron
# ULTRON_GCP_SECRET_NAME=projects/demo/secrets/google-api-key/versions/latest

# --- Error tracking (optional) ---------------------------------
# ULTRON_SENTRY_DSN=https://public@o0.ingest.sentry.io/0

# --- Database (ULTRON_DB_ prefixed) ----------------------------
ULTRON_DB_URL=sqlite:///ultron_v6.db
# ULTRON_DB_ECHO=false
# ULTRON_DB_POOL_SIZE=5
