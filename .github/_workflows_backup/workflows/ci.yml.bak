name: CI

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  lint:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r ultron-v6/requirements-dev.lock
          pip install -e './ultron-v6[dev]'
      - name: Lint with ruff
        run: ruff check ultron-v6/ultron
      - name: Lint with flake8
        run: flake8 ultron-v6/ultron

  typecheck:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r ultron-v6/requirements-dev.lock
          pip install -e './ultron-v6[dev]'
      - name: Type check with mypy
        run: mypy ultron-v6/ultron

  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r ultron-v6/requirements-dev.lock
          pip install -e './ultron-v6[dev]'
      - name: Run tests with coverage
        run: pytest --cov=ultron --cov-fail-under=85 -q

  security:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r ultron-v6/requirements.lock
          pip install -r ultron-v6/requirements-dev.lock
          pip install -e './ultron-v6[dev]'
      - name: Security scan with bandit
        run: bandit -r ultron-v6/ultron
      - name: Dependency audit with pip-audit
        run: pip-audit -r ultron-v6/requirements.lock
