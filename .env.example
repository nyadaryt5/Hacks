# ULTRON v6 environment configuration
# Copy this file to .env for local development. Keep every real credential
# outside Git; production deployments should use a configured secret backend.

# Google AI credentials (one key is required for `ultron-v6 run`).
GOOGLE_API_KEY=
# GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
# GOOGLE_API_KEY_4=
# GOOGLE_API_KEY_5=
# GOOGLE_API_KEY_6=
# GOOGLE_API_KEY_7=
# GOOGLE_API_KEY_8=
# GOOGLE_API_KEY_9=
# GOOGLE_API_KEY_10=

# Google AI client tuning.
ULTRON_MODEL=gemini-1.5-flash
ULTRON_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
ULTRON_MAX_RPM_PER_KEY=14
ULTRON_MAX_RPD_PER_KEY=1400
ULTRON_TEMPERATURE=0.3
ULTRON_MAX_TOKENS=3000
ULTRON_TIMEOUT_SECONDS=120

# Agent run controls.
ULTRON_MAX_ITERATIONS=30
ULTRON_MAX_LATERAL_DEPTH=2
ULTRON_OUTPUT_MAX_CHARS=4000
ULTRON_CACHE_TTL_HOURS=24

# Logging, HTTP/Compose port, and optional error tracking.
ULTRON_PORT=8080
ULTRON_LOG_LEVEL=INFO
ULTRON_JSON_LOGS=false
# ULTRON_SENTRY_DSN=

# Budget guardrails.
ULTRON_BUDGET_MAX_TOKENS_PER_SESSION=500000
ULTRON_BUDGET_MAX_TOKENS_PER_MINUTE=10000
ULTRON_BUDGET_MAX_TOKENS_PER_HOUR=100000
ULTRON_BUDGET_MAX_COST_PER_SESSION_USD=1.0
ULTRON_BUDGET_WARN_AT_PERCENT=80.0

# Database.
ULTRON_DB_URL=sqlite:///ultron_v6.db
ULTRON_DB_ECHO=false
ULTRON_DB_POOL_SIZE=5

# Secret source: env (local default), aws, vault, or gcp. A selected manager
# is authoritative and fail-closed; ULTRON never falls back to an env key when
# manager configuration, access, or payload resolution fails.
ULTRON_SECRETS_BACKEND=env

# AWS Secrets Manager (required when ULTRON_SECRETS_BACKEND=aws).
# ULTRON_AWS_SECRET_ID=ultron/google-api-key
# ULTRON_AWS_REGION=us-east-1
# AWS_REGION=us-east-1  # standard fallback when ULTRON_AWS_REGION is unset

# HashiCorp Vault KV v2 (required when ULTRON_SECRETS_BACKEND=vault).
# ULTRON_VAULT_ADDR=https://vault.example:8200
# ULTRON_VAULT_TOKEN=
# ULTRON_VAULT_SECRET_PATH=ultron
# VAULT_ADDR=https://vault.example:8200  # standard fallback
# VAULT_TOKEN=                         # standard fallback

# GCP Secret Manager (required when ULTRON_SECRETS_BACKEND=gcp).
# ULTRON_GCP_SECRET_NAME=projects/example/secrets/google-api-key/versions/latest
